  "domain_anchors": ["interface", "intf", "neigh", "nexthop", "port", "route", "routing", "vlan", "vnet", "vrf", "vxlan"],
  "patterns": [
    {
      "id": "string-find",
      "ast": ["$S.find($$$ARGS)", "$S->find($$$ARGS)"],
      "regex": "(?:\\.|->)\\s*find\\s*\\([^;{}]*?\\)"
    },
    {
      "id": "string-rfind",
      "ast": ["$S.rfind($$$ARGS)", "$S->rfind($$$ARGS)"],
      "regex": "(?:\\.|->)\\s*rfind\\s*\\([^;{}]*?\\)"
    },
    {
      "id": "string-compare",
      "ast": ["$S.compare($$$ARGS)", "$S->compare($$$ARGS)"],
      "regex": "(?:\\.|->)\\s*compare\\s*\\([^;{}]*?\\)"
    },
    {
      "id": "starts-with",
      "ast": ["$S.starts_with($$$ARGS)", "boost::starts_with($$$ARGS)"],
      "regex": "(?:\\.|\\bboost::)\\s*starts_with\\s*\\([^;{}]*?\\)"
    },
    {
      "id": "bounded-c-compare",
      "ast": ["strncmp($$$ARGS)", "strncasecmp($$$ARGS)"],
      "regex": "\\b(?:strncmp|strncasecmp)\\s*\\([^;{}]*?\\)"
    },
    {
      "id": "key-substring",
      "ast": ["$S.substr($$$ARGS)", "$S->substr($$$ARGS)"],
      "regex": "(?:\\.|->)\\s*substr\\s*\\([^;{}]*?\\)"
    },
    {
      "id": "key-tokenize",
      "ast": ["tokenize($$$ARGS)", "swss::tokenize($$$ARGS)"],
      "regex": "\\b(?:swss::)?tokenize\\s*\\([^;{}]*?\\)"
    }
  ],
  "grouping": {"policy": "per-file", "context_lines": 12, "scope": "line-window"},
  "restrictions": {"read_only_source": true, "static_only": true, "local_only": true, "provider_calls": false}
