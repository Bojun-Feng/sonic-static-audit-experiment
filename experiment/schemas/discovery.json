{
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "path", "start_line", "end_line", "root_cause", "evidence", "impact",
                     "defect_kind", "wg_fit", "intended_behavior", "intention_clear", "impact_reachable",
                     "fix_summary", "fix_logic_lines", "files_touched", "fix_unique",
                     "defect_confidence", "remedy_confidence"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "root_cause": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "defect_kind": {"type": "string", "enum": ["prefix-vs-exact", "substring-vs-exact",
                                                    "structured-key-wrong-component", "delimiter-boundary-missing",
                                                    "identity-typo", "exact-match-edge-case"]},
          "wg_fit": {"type": "boolean"},
          "intended_behavior": {"type": "string", "minLength": 1},
          "intention_clear": {"type": "boolean"},
          "impact_reachable": {"type": "boolean"},
          "fix_summary": {"type": "string", "minLength": 1},
          "fix_logic_lines": {"type": "integer", "minimum": 1},
          "files_touched": {"type": "integer", "minimum": 1},
          "fix_unique": {"type": "boolean"},
          "defect_confidence": {"type": "integer", "minimum": 1, "maximum": 5},
          "remedy_confidence": {"type": "integer", "minimum": 1, "maximum": 5}
        }
      }
    }
  }
}
